{
  "expo": {
    "name": "Campus Social",
    "slug": "campus-social",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "campussocial",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "ke.campussocial.app.dev",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "ke.campussocial.app.dev",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#1D4ED8"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#0B0F19"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Campus Social uses the photos you choose to attach to your posts. It cannot see the rest of your library.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:3000"
    }
  }
}

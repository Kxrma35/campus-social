{
  "name": "campus-social-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lifecycle": "tsx src/scripts/lifecycle.ts",
    "test": "vitest run",
    "admin": "tsx src/admin/index.ts",
    "moderator": "tsx src/scripts/moderator.ts",
    "unmask": "tsx src/scripts/unmask.ts",
    "legal-hold": "tsx src/scripts/legal-hold.ts",
    "verify-keys": "tsx src/scripts/verify-keys.ts",
    "rotate-keys": "tsx src/scripts/rotate-keys.ts",
    "security": "tsx src/scripts/security.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

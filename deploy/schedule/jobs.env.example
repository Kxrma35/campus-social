# Copy to /etc/moku/jobs.env and restrict it: chmod 600, owned by root.
# Nothing here is read by the API or the admin service.

# Where state markers and logs live.
JOB_STATE_DIR=/var/lib/moku-jobs

# Where a failure is reported. Set exactly one. It is your endpoint, not ours: nothing is sent
# anywhere unless you set one of these, and a message holds only the job name, host and code.
#ALERT_WEBHOOK_URL=https://your-alert-endpoint.example/moku
#ALERT_COMMAND=/usr/local/bin/send-mail-to-oncall

# Backup job. There are no defaults for these: they are your decisions.
OWNER_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/campus_social
BACKUP_DIR=/var/backups/moku
BACKUP_KEEP_DAYS=CHANGE_ME
BACKUP_ENCRYPT_TO=CHANGE_ME
#BACKUP_PHOTOS_DIR=/var/lib/moku/photos
